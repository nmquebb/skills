{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nmquebb/skills/v2/skills/q-workflow/references/config.schema.json",
  "title": "Optional q project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codeStyle": {
          "$ref": "#/$defs/paths",
          "default": []
        },
        "testing": {
          "$ref": "#/$defs/paths",
          "default": []
        },
        "architecture": {
          "$ref": "#/$defs/paths",
          "default": []
        },
        "baseline": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "x-default": "unset"
        },
        "formatCheck": {
          "type": "string",
          "x-default": "unset"
        },
        "lint": {
          "type": "string",
          "x-default": "unset"
        },
        "typecheck": {
          "type": "string",
          "x-default": "unset"
        },
        "test": {
          "type": "string",
          "x-default": "unset"
        },
        "build": {
          "type": "string",
          "x-default": "unset"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "threatModel": {
          "type": "string",
          "default": "docs/threat-model.md"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "launcher": {
          "enum": [
            "native",
            "paseo"
          ],
          "default": "native"
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewerA": {
              "type": "string",
              "x-default": "unset"
            },
            "reviewerB": {
              "type": "string",
              "x-default": "unset"
            },
            "adjudicator": {
              "type": "string",
              "x-default": "unset"
            },
            "evidence": {
              "type": "string",
              "x-default": "unset"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
